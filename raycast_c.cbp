<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="raycast" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="Debug/raycast" prefix_auto="1" extension_auto="1" />
				<Option object_output="Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Option parameters="..\level.map" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="Release/raycast" prefix_auto="1" extension_auto="1" />
				<Option object_output="Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Option parameters="..\level.map" />
				<Compiler>
					<Add option="-O3" />
				</Compiler>
				<Linker>
					<Add option="-static" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wunreachable-code" />
			<Add option="-Wall" />
			<Add option="-m64" />
		</Compiler>
		<Linker>
			<Add option="-static-libgcc" />
			<Add option="-static" />
			<Add option="-m64" />
			<Add library="gdi32" />
			<Add library="user32" />
			<Add library="kernel32" />
			<Add library="comctl32" />
			<Add library="gdiplus" />
		</Linker>
		<ExtraCommands>
			<Add after='cmd /c &quot;objdump -h -S -M intel $(TARGET_OUTPUT_FILE) &gt; $(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).lss&quot;' />
			<Add after='cmd /c nm &quot;$(TARGET_OUTPUT_FILE)&quot; &gt; &quot;$(TARGET_OUTPUT_DIR)\$(TARGET_OUTPUT_BASENAME).lst&quot;' />
		</ExtraCommands>
		<Unit filename="gdi_colors.h" />
		<Unit filename="main.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="main_c.h" />
		<Extensions>
			<code_completion />
			<envvars />
			<debugger />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
